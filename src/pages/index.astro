---
import Layout from "@/layouts/Layout.astro";
import {
	Card,
	Container,
	Heading,
	Section,
	Text,
} from "@/components";
import { Image } from "astro:assets";

import { siteContent } from "@/utils/siteContent";
import { Icon } from 'astro-icon/components';
---

<Layout title="Home Page" description="Home Page Description">
	<Section id={"hero"} class={"pb-20"} title={"hero"}>
		<Container>
			<div class="container py-12 mx-auto mt-px max-w-md text-left sm:max-w-xl sm:px-4 sm:py-12 md:max-w-none md:text-center">
				<Heading level={1} class="text-4xl font-semibold tracking-tight text-left leading-tighter text-balance sm:mx-auto sm:text-center sm:text-5xl md:max-w-3xl md:text-6xl lg:text-7xl">
					{siteContent.hero.title.main} <span class="pl-4 text-blue-400">{siteContent.hero.title.highlight}</span>
				</Heading>
				<Text class="mx-auto mt-5 max-w-[80ch] sm:text-center md:mt-8 md:text-2xl lg:max-w-lg">
					{siteContent.hero.subtitle}
				</Text>
				<div class="flex flex-col justify-center items-center mt-8 space-y-4 font-semibold text-center sm:flex-row sm:space-x-4 sm:space-y-0">
					<span class="inline-flex relative w-full sm:w-auto">
						<a href={siteContent.hero.primaryCTA.href} class="inline-flex justify-center items-center px-6 py-3 w-full text-base leading-6 text-white bg-gray-900 rounded-full border border-transparent inset-shadow-xs inset-shadow-white/30 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-800 focus:ring-offset-2 sm:w-auto md:px-9 md:py-4">
							{siteContent.hero.primaryCTA.text}
						</a>
					</span>
					<span class="inline-flex relative w-full sm:w-auto">
						<a href={siteContent.hero.secondaryCTA.href} class="inline-flex justify-center items-center px-6 py-3 w-full text-base leading-6 text-gray-900 bg-white rounded-full border border-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-800 focus:ring-offset-2 sm:w-auto md:px-9 md:py-4">
							{siteContent.hero.secondaryCTA.text}
						</a>
					</span>
				</div>
			</div>
		</Container>
	</Section>

	<Section id={siteContent.services.id} title={siteContent.services.title}>
		<Container>
			<div class="mb-12 text-center">
				<Heading level={2} class="mb-4 text-3xl font-black md:text-5xl">{siteContent.services.title}</Heading>
				<Text class="mx-auto max-w-2xl text-xl">
					{siteContent.services.subtitle}
				</Text>
			</div>
			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
				{siteContent.services.items.map(service => (
					<Card class="glass hover:border-primary/50 cursor-pointer rounded-xl border border-border p-6 transition-all">
						<div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-gradient-to-br from-primary to-accent">
							<Icon name={service.icon} class="h-6 w-6" />
						</div>
						<Heading level={3} class="mb-2 text-xl font-bold">{service.title}</Heading>
						<Text class="text-sm">{service.description}</Text>
					</Card>
				))}
			</div>
		</Container>
	</Section>

	<Section id="cta" title={"cta"}>
		<Container>
			<div class="grid items-center gap-12 lg:grid-cols-2">
				<div>
					<div
						class="bg-primary/20 text-primary mb-4 inline-block rounded px-3 py-1 font-mono text-sm"
					>
						THE API GUY
					</div>
					<h2 class="mb-6 text-3xl font-black md:text-4xl">
						We Speak Your Language
					</h2>
					<p class="mb-6 text-lg">
						Led by Steve McDougall, known in the community as
						"JustSteveKing" and "The API Guy", we understand what
						developers need because we are developers.
					</p>
					<p class="mb-8 text-lg">
						We don't just create content – we craft experiences that
						developers actually want to engage with, from RESTful
						API tutorials to advanced architectural patterns.
					</p>
					<div class="flex items-center space-x-6">
						<a
							href="#"
							class="text-primary hover:text-accent flex items-center transition-colors"
						>
							<svg
								class="mr-2 h-5 w-5"
								fill="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"
								></path>
							</svg>
							@JustSteveKing
						</a>
					</div>
				</div>
				<div>
					<div class="space-y-4">
						<div
							class="bg-card-bg border border-border font-mono rounded-lg p-4"
						>
							<div class="mb-2 flex items-center justify-between">
								<span class="font-mono text-sm text-green-400">
									GET
								</span>
								<span class="text-xs">
									200 OK
								</span>
							</div>
							<code class="text-sm">
								/api/developers/engagement
							</code>
						</div>
						<div
							class="bg-card-bg border border-border font-mono rounded-lg p-4"
						>
							<div class="mb-2 flex items-center justify-between">
								<span class="font-mono text-sm text-yellow-400">
									POST
								</span>
								<span class="text-xs">
									201 Created
								</span>
							</div>
							<code class="text-sm">
								/api/content/technical-blogs
							</code>
						</div>
						<div
							class="bg-card-bg border border-border font-mono rounded-lg p-4"
						>
							<div class="mb-2 flex items-center justify-between">
								<span class="font-mono text-sm text-blue-400">
									PUT
								</span>
								<span class="text-xs">
									200 OK
								</span>
							</div>
							<code class="text-sm">
								/api/workshops/hands-on-training
							</code>
						</div>
						<div
							class="bg-card-bg border border-border font-mono rounded-lg p-4"
						>
							<div class="mb-2 flex items-center justify-between">
								<span class="font-mono text-sm text-purple-400">
									PATCH
								</span>
								<span class="text-xs">
									204 NO CONTENT
								</span>
							</div>
							<code class="text-sm">
								/api/devrel/strategy
							</code>
						</div>
					</div>
				</div>
			</div>
		</Container>
	</Section>

	<Section id="about" title={"about"}>
		<Container>
			<div class="mb-12 text-center">
				<h2 class="mb-4 text-3xl font-black md:text-5xl">
					Meet The Team
				</h2>
				<p class="mx-auto max-w-2xl text-xl">
					A husband and wife team passionate about building better
					developer experiences
				</p>
			</div>

			<div class="mx-auto grid max-w-4xl gap-8 md:grid-cols-2">
				<div class="glass rounded-xl border border-border p-8">
					<div
						class="mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-br from-primary to-secondary"
					>
						<Image
							src="/images/steve.png"
							alt="Steve McDougall"
							format={"webp"}
							height={400}
							width={400}
							decoding="async"
							class="size-18"
						/>
					</div>
					<h3 class="mb-2 text-2xl font-bold">Steve McDougall</h3>
					<p class="mb-4 font-mono text-sm">
						The API Guy • JustSteveKing
					</p>
					<p class="mb-6">
						Technical content creator, API enthusiast, and developer
						advocate with years of experience building and teaching.
						Steve leads our technical content strategy and delivers
						workshops that developers rave about.
					</p>
					<div class="flex space-x-4">
						<a
							href="#"
							title="twitter" aria-labelledby="twitter"
							class="transition-colors text-gray-400 hover:text-primary"
						>
							<svg
								class="h-5 w-5"
								fill="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"
								></path>
							</svg>
						</a>
					</div>
				</div>

				<div class="glass rounded-xl border border-border p-8">
					<div
						class="mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-br from-primary to-secondary"
					>
						<Image
							src="/images/amy.png"
							alt="Amy McDougall"
							format={"webp"}
							height={400}
							width={400}
							decoding="async"
							class="size-18"
						/>
					</div>
					<h3 class="mb-2 text-2xl font-bold">Amy McDougall</h3>
					<p class="mb-4 font-mono text-sm text-primary">
						Operations Mastermind
					</p>
					<p class="mb-6">
						The operational backbone of Lila Fuches, Amy ensures
						everything runs smoothly behind the scenes. From project
						management to client relations, she makes sure our
						content delivers on time and exceeds expectations
					</p>
					<div class="flex space-x-4">
						<a
							href="#"
							title="twitter" aria-labelledby="twitter"
							class="transition-colors text-gray-400 hover:text-primary"
						>
							<svg
								class="h-5 w-5"
								fill="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"
								></path>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</Container>
	</Section>

	<Section id="content" title={"content"}>
		<Container>
			<div class="mb-12 text-center">
				<h2 class="mb-4 text-3xl font-black md:text-5xl">
					Content That Converts
				</h2>
				<p class="mx-auto max-w-2xl text-xl ">
					From quick tutorials to deep-dive workshops, we create
					content that drives developer adoption
				</p>
			</div>

			<div class="grid gap-8 md:grid-cols-3">
				<div
					class="rounded-xl border border-border bg-gradient-to-br from-slate-900 to-slate-800 p-6"
				>
					<div class="mb-4 flex items-center justify-between">
						<span class="font-mono text-xs text-green-400">
							Blog Post
						</span>
						<span class="text-xs">5 min read</span>
					</div>
					<h3 class="mb-2 text-lg font-bold">
						Building RESTful APIs with Laravel
					</h3>
					<p class="mb-4 text-sm ">
						A comprehensive guide to building scalable, maintainable
						APIs that developers love to work with.
					</p>
					<div class="flex items-center justify-between">
						<div class="flex items-center">
							<div class="flex -space-x-2">
								<span
									class="inline-block rounded px-2 py-1 text-xs bg-primary/20"
								>
									PHP
								</span>
								<span
									class="inline-block rounded px-2 py-1 text-xs bg-primary/20"
								>
									Laravel
								</span>
							</div>
							<span
								class="live-indicator mr-2 h-2 w-2 rounded-full bg-red-500"
							></span>
							<span class="text-xs text-red-500">LIVE</span>
							<span class="text-cyan-400 text-xs">
								20 Spots left
							</span>
						</div>
						<span class="text-primary text-sm">→</span>
					</div>
				</div>

				<div
					class="rounded-xl border border-border bg-gradient-to-br from-slate-900 to-slate-800 p-6"
				>
					<div class="mb-4 flex items-center justify-between">
						<span class="font-mono text-xs text-green-400">
							Blog Post
						</span>
						<span class="text-xs">5 min read</span>
					</div>
					<h3 class="mb-2 text-lg font-bold">
						Building RESTful APIs with Laravel
					</h3>
					<p class="mb-4 text-sm ">
						A comprehensive guide to building scalable, maintainable
						APIs that developers love to work with.
					</p>
					<div class="flex items-center justify-between">
						<div class="flex items-center">
							<div class="flex -space-x-2">
								<span
									class="inline-block rounded px-2 py-1 text-xs bg-primary/20"
								>
									PHP
								</span>
								<span
									class="inline-block rounded px-2 py-1 text-xs bg-primary/20"
								>
									Laravel
								</span>
							</div>
							<span
								class="live-indicator mr-2 h-2 w-2 rounded-full bg-red-500"
							></span>
							<span class="text-xs text-red-500">LIVE</span>
							<span class="text-cyan-400 text-xs">
								20 Spots left
							</span>
						</div>
						<span class="text-primary text-sm">→</span>
					</div>
				</div>

				<div
					class="rounded-xl border border-border bg-gradient-to-br from-slate-900 to-slate-800 p-6"
				>
					<div class="mb-4 flex items-center justify-between">
						<span class="font-mono text-xs text-green-400">
							Blog Post
						</span>
						<span class="text-xs">5 min read</span>
					</div>
					<h3 class="mb-2 text-lg font-bold">
						Building RESTful APIs with Laravel
					</h3>
					<p class="mb-4 text-sm ">
						A comprehensive guide to building scalable, maintainable
						APIs that developers love to work with.
					</p>
					<div class="flex items-center justify-between">
						<div class="flex items-center">
							<div class="flex -space-x-2">
								<span
									class="inline-block rounded px-2 py-1 text-xs bg-primary/20"
								>
									PHP
								</span>
								<span
									class="inline-block rounded px-2 py-1 text-xs bg-primary/20"
								>
									Laravel
								</span>
							</div>
							<span
								class="live-indicator mr-2 h-2 w-2 rounded-full bg-red-500"
							></span>
							<span class="text-xs text-red-500">LIVE</span>
							<span class="text-cyan-400 text-xs">
								20 Spots left
							</span>
						</div>
						<span class="text-primary text-sm">→</span>
					</div>
				</div>
			</div>
		</Container>
	</Section>

	<Section id="why" title={"why"}>
		<Container>
			<div class="mb-12 text-center">
				<h2 class="mb-4 text-3xl font-black md:text-5xl">
					Why Developers Trust Us
				</h2>
			</div>

			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
				<div class="text-center">
					<div
						class="bg-gradient-to-r from-primary to-accent bg-clip-text mb-2 text-4xl font-black text-transparent"
					>
						<span
							class="bg-gradient-to-r from-blue-400 to-blue-600 bg-clip-text text-transparent"
						>
							100%
						</span>
					</div>

					<p class="">Developer-First Approach</p>
				</div>

				<div class="text-center">
					<div
						class="bg-gradient-to-r from-primary to-accent bg-clip-text mb-2 text-4xl font-black text-transparent"
					>
						<span
							class="bg-gradient-to-r from-blue-400 to-blue-600 bg-clip-text text-transparent"
						>
							500+
						</span>
					</div>

					<p class="">Pieces of Content Created</p>
				</div>

				<div class="text-center">
					<div
						class="bg-gradient-to-r from-primary to-accent bg-clip-text mb-2 text-4xl font-black text-transparent"
					>
						<span
							class="bg-gradient-to-r from-blue-400 to-blue-600 bg-clip-text text-transparent"
						>
							50k+
						</span>
					</div>

					<p class="">Developers Reached</p>
				</div>

				<div class="text-center">
					<div
						class="bg-gradient-to-r from-primary to-accent bg-clip-text mb-2 text-4xl font-black text-transparent"
					>
						<span
							class="bg-gradient-to-r from-blue-400 to-blue-600 bg-clip-text text-transparent"
						>
							12+
						</span>
					</div>

					<p class="">Years of Experience</p>
				</div>
			</div>
		</Container>
	</Section>

	<Section id="contact" title={"contact"} class="text-center">
		<Container>
			<div class="glass border-border/30 rounded-2xl border p-12">
				<h2 class="mb-6 text-3xl font-black md:text-5xl">
					Ready to Create Better Content?
				</h2>
				<p class="mb-8 text-xl text-gray-300">
					Let's create content that developers actually want to engage
					with.
				</p>
				<div class="flex flex-col justify-center gap-4 sm:flex-row">
					<a href="#"> Get In Touch </a>
					<a href="#"> Book a Workshop </a>
				</div>
			</div>
		</Container>
	</Section>
</Layout>
