---
import Layout from "@/layouts/Layout.astro";
import {
	Accent,
	Button,
	ClientLogo,
	Container,
	Heading,
	Section,
	StatsCard,
	TeamMemberCard,
	TestimonialGrid,
	Text,
} from "@/components";

import { siteContent } from "@/utils/siteContent";
import { Icon } from 'astro-icon/components';

// Additional structured data for homepage
const homepageStructuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebPage",
			"@id": "https://lilafuches.com/#webpage",
			"url": "https://lilafuches.com/",
			"name": siteContent.site.title,
			"description": siteContent.site.description,
			"isPartOf": { "@id": "https://lilafuches.com/#organization" },
			"breadcrumb": { "@id": "https://lilafuches.com/#breadcrumb" }
		},
		{
			"@type": "BreadcrumbList",
			"@id": "https://lilafuches.com/#breadcrumb",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"item": {
						"@type": "WebPage",
						"@id": "https://lilafuches.com/",
						"url": "https://lilafuches.com/",
						"name": "Home"
					}
				}
			]
		}
	]
};
---

<Layout
	title={siteContent.site.title}
	description={siteContent.site.description}
	keywords={siteContent.site.keywords}
>
	<script type="application/ld+json" set:html={JSON.stringify(homepageStructuredData)} slot="head"></script>

	<!-- Hero Section -->
	<Section id="hero" class="pt-48 pb-48 border-b-2 border-border overflow-hidden" title="hero">
		<Container>
			<div class="relative">
				<div class="absolute -top-16 -left-8 text-9xl font-black opacity-[0.03] select-none pointer-events-none uppercase tracking-tighter">
					Lila Fuches
				</div>
				<Heading level={1} class="text-6xl md:text-9xl font-black tracking-tight text-foreground leading-[0.9] mb-20 animate-fade-in-up">
					{siteContent.hero.title.main}<br />
					<span class="text-accent italic font-serif font-medium">{siteContent.hero.title.highlight}</span>
				</Heading>

				<div class="grid lg:grid-cols-12 gap-12 items-start border-t border-border/50 pt-12">
					<div class="lg:col-span-7">
						<Text class="text-xl md:text-2xl text-foreground/80 leading-tight tracking-tight font-medium">
							{siteContent.hero.subtitle}
						</Text>
					</div>
					<div class="lg:col-span-5 flex flex-col gap-8 md:pl-12 border-l border-border/50">
						<div class="flex flex-col sm:flex-row gap-4">
							<Button variant="primary" size="lg" href={siteContent.hero.primaryCTA.href}>
								{siteContent.hero.primaryCTA.text}
							</Button>
							<Button variant="outline" size="lg" href={siteContent.hero.secondaryCTA.href}>
								{siteContent.hero.secondaryCTA.text}
							</Button>
						</div>
						<div class="text-[10px] font-mono uppercase tracking-[0.3em] text-muted-foreground border border-border/20 px-3 py-1.5 self-start rounded">
							{siteContent.hero.badge}
						</div>
					</div>
				</div>
			</div>
		</Container>
	</Section>

	<!-- Client Logos -->
	<Section id="trusted-by" title="Clients" class="py-16 border-b border-border/50 bg-muted/30">
		<Container>
			<div class="flex flex-wrap items-center justify-between gap-12 grayscale opacity-40">
				{siteContent.clients.logos.map((client) => (
					<ClientLogo {...client} alt={`${client.name} logo`} class="p-0 transition-none contrast-125" />
				))}
			</div>
		</Container>
	</Section>

	<!-- Services Intro -->
	<Section id="how-we-help" title="Services" class="pt-48 pb-24 bg-background">
		<Container>
			<div class="border-l-4 border-accent pl-12 max-w-4xl">
				<Heading level={2} class="text-xs font-mono uppercase tracking-[0.5em] text-muted-foreground mb-8">
					{siteContent.pillars.title}
				</Heading>
				<Text class="text-4xl md:text-6xl font-black text-foreground leading-[1.1] tracking-tight uppercase">
					{siteContent.pillars.subtitle}
				</Text>
			</div>
		</Container>
	</Section>

	<!-- Individual Service Sections -->
	{siteContent.pillars.items.map((pillar, index) => (
		<Section 
			id={pillar.id} 
			title={pillar.title} 
			class={`py-0 border-b border-border/30 ${index % 2 === 0 ? 'bg-background' : 'bg-muted/20'}`}
		>
			<div class="grid lg:grid-cols-12 min-h-[500px]">
				<div class={`lg:col-span-6 p-12 md:p-20 flex flex-col justify-center ${index % 2 !== 0 ? 'lg:order-last border-l border-border/30' : 'border-r border-border/30'}`}>
					<div class="flex items-center gap-4 mb-8">
						<div class="text-accent font-mono text-xs font-black tracking-widest">
							STEP // 0{index + 1}
						</div>
						<div class="h-px flex-1 bg-border/20"></div>
					</div>

					<Heading level={3} class="text-4xl md:text-6xl font-black text-foreground mb-8 tracking-tight leading-none uppercase italic">
						{pillar.title}
					</Heading>
					
					<Text class="text-xl md:text-2xl text-foreground/80 leading-tight tracking-tight mb-12 font-medium">
						{pillar.description}
					</Text>
					
					<Button variant="accent" size="lg" href={siteContent.hero.primaryCTA.href} class="self-start">
						Learn More
					</Button>
				</div>
				
				<div class={`lg:col-span-6 p-12 md:p-20 bg-background flex flex-col justify-center`}>
					<Heading level={4} class="text-xs font-mono uppercase tracking-[0.4em] text-muted-foreground mb-10">
						Key Specialisms
					</Heading>
					<ul class="grid sm:grid-cols-2 gap-4">
						{pillar.features.map((feature) => (
							<li class="flex items-center group/item border border-border/20 p-4 rounded-md hover:border-accent/50 transition-colors">
								<div class="w-1.5 h-1.5 bg-accent mr-4 rounded-full"></div>
								<span class="text-sm font-bold text-foreground tracking-tight uppercase">
									{feature}
								</span>
							</li>
						))}
					</ul>
				</div>
			</div>
		</Section>
	))}

	<!-- Expertise/Stats -->
	<Section id="expertise" title="Expertise" class="py-24 border-b border-border/30 bg-background">
		<Container>
			<Heading level={2} class="sr-only">{siteContent.statistics.title}</Heading>
			<div class="grid grid-cols-2 lg:grid-cols-4 border border-border/20 rounded-lg overflow-hidden divide-x divide-y sm:divide-y-0 divide-border/20">
				{siteContent.statistics.stats.map((stat) => (
					<div class="flex flex-col p-10 bg-background hover:bg-muted/30 transition-colors">
						<div class="text-5xl md:text-7xl font-black tracking-tight text-foreground mb-4 leading-none">{stat.number}</div>
						<div class="text-[10px] font-mono uppercase tracking-[0.3em] text-muted-foreground">{stat.label}</div>
					</div>
				))}
			</div>
		</Container>
	</Section>

	<!-- Testimonials -->
	<Section id="testimonials" title="Testimonials" class="py-48 bg-muted/20 border-b border-border/30">
		<Container>
			<div class="grid lg:grid-cols-12 gap-20">
				<div class="lg:col-span-5 border-l-4 border-accent pl-12">
					<Heading level={2} class="text-xs font-mono uppercase tracking-[0.5em] text-accent mb-6">
						{siteContent.testimonials.title}
					</Heading>
					<Heading level={3} class="text-4xl md:text-5xl font-black text-foreground leading-[1.1] tracking-tight uppercase italic">
						{siteContent.testimonials.subtitle}
					</Heading>
				</div>
				<div class="lg:col-span-7 border border-border/20 bg-background p-12 md:p-20 rounded-xl shadow-soft">
					<TestimonialGrid testimonials={siteContent.testimonials.items} columns={1} class="gap-20" />
				</div>
			</div>
		</Container>
	</Section>

	<!-- Founders Section -->
	<Section id="about" title="About" class="py-48 bg-background">
		<Container>
			<div class="mb-24 border-b-2 border-border/20 pb-20">
				<Heading level={2} class="text-xs font-mono uppercase tracking-[0.5em] text-muted-foreground mb-8">
					{siteContent.about.title}
				</Heading>
				<Text class="text-5xl md:text-8xl font-black text-foreground max-w-5xl tracking-tight leading-[0.9] uppercase">
					{siteContent.about.subtitle}
				</Text>
			</div>
			<div class="grid lg:grid-cols-2 gap-8">
				{siteContent.about.team.map((member) => (
					<div class="bg-background rounded-2xl overflow-hidden border border-border/10 shadow-soft hover:shadow-strong transition-all duration-300">
						<TeamMemberCard {...member} />
					</div>
				))}
			</div>
		</Container>
	</Section>

	<!-- CTA Section -->
	<Section id="cta" title="Contact" class="py-48 border-t-2 border-border bg-accent text-accent-foreground">
		<Container>
			<div class="max-w-6xl">
				<Heading level={2} class="text-xs font-mono uppercase tracking-[0.5em] text-accent-foreground/60 mb-10">
					Get in Touch
				</Heading>
				<Heading level={3} class="text-6xl md:text-9xl font-black tracking-tighter mb-12 leading-[0.9] uppercase italic">
					{siteContent.cta.title.split(' ').slice(0, -1).join(' ')} <br />
					<span class="text-background/90">{siteContent.cta.title.split(' ').pop()}</span>
				</Heading>
				<Text class="text-2xl md:text-4xl text-accent-foreground mb-16 max-w-4xl font-bold tracking-tight leading-tight">
					{siteContent.cta.subtitle}
				</Text>
				<Button
					variant="secondary"
					size="lg"
					href={siteContent.cta.primaryButton.href}
					class="text-xl py-6 px-12 border-2 border-background hover:bg-background hover:text-accent rounded-lg"
				>
					{siteContent.cta.primaryButton.text}
				</Button>
			</div>
		</Container>
	</Section>
</Layout>
