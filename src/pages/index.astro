---
import Layout from "@/layouts/Layout.astro";
import {
	Accent,
	Button,
	ClientLogo,
	Container,
	Heading,
	Section,
	StatsCard,
	TeamMemberCard,
	TestimonialGrid,
	Text,
} from "@/components";

import { siteContent } from "@/utils/siteContent";
import { Icon } from 'astro-icon/components';

// Additional structured data for homepage
const homepageStructuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebPage",
			"@id": "https://lilafuches.com/#webpage",
			"url": "https://lilafuches.com/",
			"name": siteContent.site.title,
			"description": siteContent.site.description,
			"isPartOf": { "@id": "https://lilafuches.com/#organization" },
			"breadcrumb": { "@id": "https://lilafuches.com/#breadcrumb" }
		},
		{
			"@type": "BreadcrumbList",
			"@id": "https://lilafuches.com/#breadcrumb",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"item": {
						"@type": "WebPage",
						"@id": "https://lilafuches.com/",
						"url": "https://lilafuches.com/",
						"name": "Home"
					}
				}
			]
		}
	]
};
---

<Layout
	title={siteContent.site.title}
	description={siteContent.site.description}
	keywords={siteContent.site.keywords}
>
	<script type="application/ld+json" set:html={JSON.stringify(homepageStructuredData)} slot="head"></script>

	<!-- Hero Section -->
	<Section id="hero" class="pt-32 pb-24 md:pt-48 md:pb-48 border-b border-border/10 overflow-hidden" title="hero">
		<Container>
			<div class="relative">
				<div class="absolute -top-16 -left-8 text-7xl md:text-9xl font-black opacity-[0.03] select-none pointer-events-none uppercase tracking-tighter">
					Lila Fuches
				</div>
				<Heading level={1} class="text-4xl sm:text-6xl md:text-9xl font-black tracking-tight text-foreground leading-[0.95] md:leading-[0.9] mb-12 md:mb-20 animate-fade-in-up">
					{siteContent.hero.title.main}<br />
					<span class="text-accent italic font-serif font-medium">{siteContent.hero.title.highlight}</span>
				</Heading>

				<div class="grid lg:grid-cols-12 gap-8 md:gap-12 items-start border-t border-border/50 pt-8 md:pt-12">
					<div class="lg:col-span-7">
						<Text class="text-lg md:text-2xl text-foreground/80 leading-snug md:leading-tight tracking-tight font-medium">
							{siteContent.hero.subtitle}
						</Text>
					</div>
					<div class="lg:col-span-5 flex flex-col gap-6 md:gap-8 md:pl-12 md:border-l border-border/50">
						<div class="flex flex-col sm:flex-row gap-4">
							<Button variant="primary" size="lg" href={siteContent.hero.primaryCTA.href} class="w-full sm:w-auto">
								{siteContent.hero.primaryCTA.text}
							</Button>
							<Button variant="outline" size="lg" href={siteContent.hero.secondaryCTA.href} class="w-full sm:w-auto">
								{siteContent.hero.secondaryCTA.text}
							</Button>
						</div>
						<div class="text-[9px] md:text-[10px] font-mono uppercase tracking-[0.3em] text-muted-foreground border border-border/20 px-3 py-1.5 self-start rounded-full">
							{siteContent.hero.badge}
						</div>
					</div>
				</div>
			</div>
		</Container>
	</Section>

	<!-- Client Logos -->
	<Section id="trusted-by" title="Clients" class="py-20 border-b border-border/10 bg-muted/20">
		<Container>
			<div class="flex flex-col items-center gap-16">
				<Heading level={2} class="text-[10px] font-mono uppercase tracking-[0.4em] text-muted-foreground/60">
					{siteContent.clients.title}
				</Heading>
				<div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-10 md:gap-x-20">
					{siteContent.clients.logos.map((client) => (
						<ClientLogo {...client} alt={`${client.name} logo`} class="p-0" />
					))}
				</div>
			</div>
		</Container>
	</Section>

	<!-- Services Intro -->
	<Section id="how-we-help" title="Services" class="pt-24 pb-12 md:pt-48 md:pb-24 bg-background">
		<Container>
			<div class="border-l-4 border-accent pl-6 md:pl-12 max-w-4xl">
				<Heading level={2} class="text-[10px] md:text-xs font-mono uppercase tracking-[0.5em] text-muted-foreground mb-6 md:mb-8">
					{siteContent.pillars.title}
				</Heading>
				<Text class="text-3xl md:text-6xl font-black text-foreground leading-[1.1] tracking-tight uppercase">
					{siteContent.pillars.subtitle}
				</Text>
			</div>
		</Container>
	</Section>

	<!-- Individual Service Sections -->
	{siteContent.pillars.items.map((pillar, index) => (
		<Section 
			id={pillar.id} 
			title={pillar.title} 
			class={`py-0 border-b border-border/30 ${index % 2 === 0 ? 'bg-background' : 'bg-muted/20'}`}
		>
			<div class="grid lg:grid-cols-12 min-h-[400px] md:min-h-[500px]">
				<div class={`lg:col-span-6 p-8 md:p-20 flex flex-col justify-center ${index % 2 !== 0 ? 'lg:order-last lg:border-l border-border/30' : 'lg:border-r border-border/30'}`}>
					<div class="flex items-center gap-4 mb-6 md:mb-8">
						<div class="text-accent font-mono text-[10px] md:text-xs font-black tracking-widest">
							STEP // 0{index + 1}
						</div>
						<div class="h-px flex-1 bg-border/20"></div>
					</div>

					<Heading level={3} class="text-3xl md:text-6xl font-black text-foreground mb-6 md:mb-8 tracking-tight leading-none uppercase italic">
						{pillar.title}
					</Heading>
					
					<Text class="text-lg md:text-2xl text-foreground/80 leading-snug md:leading-tight tracking-tight mb-8 md:mb-12 font-medium">
						{pillar.description}
					</Text>
					
					<Button variant="accent" size="lg" href={siteContent.hero.primaryCTA.href} class="self-start w-full sm:w-auto">
						Learn More
					</Button>
				</div>
				
				<div class={`lg:col-span-6 p-8 md:p-20 bg-background flex flex-col justify-center border-t lg:border-t-0 border-border/30`}>
					<Heading level={4} class="text-[10px] md:text-xs font-mono uppercase tracking-[0.4em] text-muted-foreground mb-8 md:mb-10">
						Key Specialisms
					</Heading>
					<ul class="grid sm:grid-cols-2 gap-3 md:gap-4">
						{pillar.features.map((feature) => (
							<li class="flex items-center group/item border border-border/20 p-4 rounded-xl hover:border-accent/50 transition-colors">
								<div class="w-1.5 h-1.5 bg-accent mr-4 rounded-full"></div>
								<span class="text-xs md:text-sm font-bold text-foreground tracking-tight uppercase">
									{feature}
								</span>
							</li>
						))}
					</ul>
				</div>
			</div>
		</Section>
	))}

	<!-- Working Principles -->
	<Section id="principles" title="Principles" class="py-24 md:py-48 bg-background border-b border-border/30">
		<Container>
			<div class="text-center mb-16 md:mb-24">
				<Heading level={2} class="text-[10px] md:text-xs font-mono uppercase tracking-[0.5em] text-accent mb-6">
					{siteContent.principles.title}
				</Heading>
				<Heading level={3} class="text-3xl md:text-6xl font-black text-foreground tracking-tight uppercase italic mx-auto max-w-4xl leading-[1.1]">
					{siteContent.principles.subtitle}
				</Heading>
			</div>
			
			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
				{siteContent.principles.items.map((item) => (
					<div class="flex flex-col p-8 md:p-10 bg-muted/20 rounded-3xl border border-transparent hover:border-accent/30 transition-all duration-300">
						<div class="w-12 h-12 bg-accent/10 text-accent rounded-xl flex items-center justify-center mb-6 md:mb-8">
							<Icon name={item.icon} class="w-6 h-6" />
						</div>
						<Heading level={4} class="text-lg md:text-xl font-bold text-foreground mb-4 uppercase tracking-tight">
							{item.title}
						</Heading>
						<Text class="text-sm md:text-base text-muted-foreground leading-relaxed">
							{item.description}
						</Text>
					</div>
				))}
			</div>
		</Container>
	</Section>

	<!-- Expertise/Stats -->
	<Section id="expertise" title="Expertise" class="py-16 md:py-24 border-b border-border/30 bg-background">
		<Container>
			<Heading level={2} class="sr-only">{siteContent.statistics.title}</Heading>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border border-border/20 rounded-3xl overflow-hidden divide-y sm:divide-y-0 sm:divide-x divide-border/20">
				{siteContent.statistics.stats.map((stat) => (
					<div class="flex flex-col p-8 md:p-10 bg-background hover:bg-muted/30 transition-colors">
						<div class="text-4xl md:text-7xl font-black tracking-tight text-foreground mb-3 md:mb-4 leading-none">{stat.number}</div>
						<div class="text-[9px] md:text-[10px] font-mono uppercase tracking-[0.3em] text-muted-foreground">{stat.label}</div>
					</div>
				))}
			</div>
		</Container>
	</Section>

	<!-- Testimonials -->
	<Section id="testimonials" title="Testimonials" class="py-24 md:py-48 bg-muted/20 border-b border-border/30">
		<Container>
			<div class="grid lg:grid-cols-12 gap-12 md:gap-20">
				<div class="lg:col-span-5 border-l-4 border-accent pl-6 md:pl-12">
					<Heading level={2} class="text-[10px] md:text-xs font-mono uppercase tracking-[0.5em] text-accent mb-6">
						{siteContent.testimonials.title}
					</Heading>
					<Heading level={3} class="text-3xl md:text-5xl font-black text-foreground leading-[1.1] tracking-tight uppercase italic">
						{siteContent.testimonials.subtitle}
					</Heading>
				</div>
				<div class="lg:col-span-7 border border-border/20 bg-background p-8 md:p-20 rounded-3xl">
					<TestimonialGrid testimonials={siteContent.testimonials.items} columns={1} class="gap-12 md:gap-20" />
				</div>
			</div>
		</Container>
	</Section>

	<!-- Founders Section -->
	<Section id="about" title="About" class="py-24 md:py-48 bg-background">
		<Container>
			<div class="mb-16 md:mb-24 border-b border-border/10 pb-12 md:pb-20">
				<Heading level={2} class="text-[10px] md:text-xs font-mono uppercase tracking-[0.5em] text-muted-foreground mb-6 md:mb-8">
					{siteContent.about.title}
				</Heading>
				<Text class="text-3xl md:text-8xl font-black text-foreground max-w-5xl tracking-tight leading-[0.95] md:leading-[0.9] uppercase">
					{siteContent.about.subtitle}
				</Text>
			</div>
			<div class="grid lg:grid-cols-2 gap-8 md:gap-12">
				{siteContent.about.team.map((member) => (
					<TeamMemberCard {...member} />
				))}
			</div>
		</Container>
	</Section>

	<!-- CTA Section -->
	<Section id="cta" title="Contact" class="py-24 md:py-48 border-t border-border/10 bg-accent text-accent-foreground">
		<Container>
			<div class="max-w-6xl">
				<Heading level={2} class="text-[10px] md:text-xs font-mono uppercase tracking-[0.5em] text-accent-foreground/60 mb-8 md:mb-10">
					Get in Touch
				</Heading>
				<Heading level={3} class="text-4xl md:text-9xl font-black tracking-tighter mb-8 md:mb-12 leading-[1.1] md:leading-[0.9] uppercase italic">
					{siteContent.cta.title.split(' ').slice(0, -1).join(' ')} <br />
					<span class="text-background/90">{siteContent.cta.title.split(' ').pop()}</span>
				</Heading>
				<Text class="text-xl md:text-4xl text-accent-foreground mb-12 md:mb-16 max-w-4xl font-bold tracking-tight leading-tight">
					{siteContent.cta.subtitle}
				</Text>
				<Button
					variant="secondary"
					size="lg"
					href={siteContent.cta.primaryButton.href}
					class="text-lg md:text-xl py-5 md:py-6 px-10 md:px-12 rounded-full transition-all duration-300 w-full sm:w-auto"
				>
					{siteContent.cta.primaryButton.text}
				</Button>
			</div>
		</Container>
	</Section>
</Layout>
