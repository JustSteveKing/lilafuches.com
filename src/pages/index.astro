---
import Layout from "@/layouts/Layout.astro";
import {
	Button,
	Container,
	Heading,
	HighlightCard,
	Section,
	StatsCard,
	TeamMemberCard,
	Text,
} from "@/components";

import { siteContent } from "@/utils/siteContent";
import { Icon } from 'astro-icon/components';

// Additional structured data for homepage
const homepageStructuredData = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	"name": siteContent.site.title,
	"description": siteContent.site.description,
	"url": "https://lilafuches.com/",
	"mainEntity": {
		"@type": "Organization",
		"name": "Lila Fuches",
		"description": siteContent.site.description,
		"url": "https://lilafuches.com/",
		"foundingDate": "2019",
		"serviceType": [
			"Fractional CTO",
			"API Architecture",
			"Laravel Development",
			"Technical Content Creation",
			"Developer Education"
		],
		"areaServed": "Global"
	}
};
---

<Layout
	title={siteContent.site.title}
	description={siteContent.site.description}
	keywords={siteContent.site.keywords}
>
	<script type="application/ld+json" set:html={JSON.stringify(homepageStructuredData)} slot="head"></script>

	<!-- Hero Section -->
	<Section id="hero" class="pt-20 pb-32 border-b border-stone-200/60" title="hero">
		<Container>
			<div class="max-w-4xl">
				<div class="inline-block mb-6">
					<span class="text-[10px] font-black uppercase tracking-[0.2em] text-accent border-b-2 border-accent pb-1">
						{siteContent.hero.badge}
					</span>
				</div>

				<Heading level={1} class="text-5xl md:text-7xl font-black tracking-tight text-stone-900 dark:text-stone-100 leading-[0.95] mb-8">
					{siteContent.hero.title.main}<span class="text-stone-400 dark:text-stone-500 pl-6">{siteContent.hero.title.highlight}</span>
				</Heading>

				<Text class="text-xl md:text-2xl text-stone-600 dark:text-stone-400 leading-relaxed max-w-2xl mb-12">
					{siteContent.hero.subtitle}
				</Text>

				<div class="flex flex-col sm:flex-row gap-4">
					<Button variant="accent" size="lg" href={siteContent.hero.primaryCTA.href}>
						{siteContent.hero.primaryCTA.text}
					</Button>
					<Button variant={"outline"} size="lg" href={siteContent.hero.secondaryCTA.href}>
						{siteContent.hero.secondaryCTA.text}
					</Button>
				</div>
			</div>
		</Container>
	</Section>

	<!-- The Three Pillars -->
	<Section id="how-we-help" title="Services" class="py-24 bg-white dark:bg-stone-900">
		<Container>
			<div class="mb-16">
				<Heading level={2} class="text-xs font-black uppercase tracking-[0.3em] text-stone-400 dark:text-stone-500 mb-4">
					{siteContent.pillars.title}
				</Heading>
				<Text class="text-3xl font-bold text-stone-900 dark:text-stone-100 max-w-2xl">
					{siteContent.pillars.subtitle}
				</Text>
			</div>

			<div class="grid gap-12 lg:grid-cols-3">
				{siteContent.pillars.items.map((pillar) => (
					<div id={pillar.id} class="flex flex-col">
						<div class="mb-6 h-12 w-12 flex items-center justify-center rounded-xl bg-stone-50 dark:bg-stone-800 text-stone-800 dark:text-stone-200 border border-stone-200 dark:border-stone-700">
							<Icon name={pillar.icon} class="h-6 w-6" />
						</div>
						<Heading level={3} class="text-2xl font-black text-stone-900 dark:text-stone-100 mb-4">
							{pillar.title}
						</Heading>
						<Text class="text-stone-600 dark:text-stone-400 leading-relaxed mb-8 flex-grow">
							{pillar.description}
						</Text>
						<ul class="space-y-3">
							{pillar.features.map((feature) => (
								<li class="flex items-center text-sm font-bold text-stone-800 dark:text-stone-200 uppercase tracking-wide">
									<span class="w-1.5 h-1.5 rounded-full bg-accent mr-3"></span>
									{feature}
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		</Container>
	</Section>

	<!-- Expertise/Stats -->
	<Section id="expertise" title="Expertise" class="py-24 border-y border-stone-200/60 dark:border-stone-800 bg-stone-50/50 dark:bg-stone-950/50">
		<Container>
			<div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
				{siteContent.statistics.stats.map((stat, index) => (
					<StatsCard {...stat} index={index} />
				))}
			</div>
		</Container>
	</Section>

	<!-- Founders Section -->
	<Section id="about" title="About" class="py-24 bg-white dark:bg-stone-900">
		<Container>
			<div class="text-center mb-16">
				<Heading level={2} class="text-xs font-black uppercase tracking-[0.3em] text-stone-400 dark:text-stone-500 mb-4">
					{siteContent.about.title}
				</Heading>
				<Text class="text-3xl font-bold text-stone-900 dark:text-stone-100 mx-auto max-w-2xl">
					{siteContent.about.subtitle}
				</Text>
			</div>
			<div class="mx-auto grid max-w-5xl gap-12 md:grid-cols-2">
				{siteContent.about.team.map((member) => (
					<TeamMemberCard {...member} />
				))}
			</div>
		</Container>
	</Section>

	<!-- CTA Section -->
	<Section id="cta" title="Contact" class="py-32 bg-stone-900 dark:bg-stone-950 text-white">
		<Container>
			<div class="max-w-3xl">
				<div class="text-[10px] font-black uppercase tracking-[0.3em] text-stone-500 dark:text-stone-400 mb-6">
					Get in Touch
				</div>
				<Heading level={2} class="text-4xl md:text-6xl font-black tracking-tight mb-8 leading-none text-white">
					{siteContent.cta.title}
				</Heading>
				<Text class="text-xl text-stone-400 dark:text-stone-300 mb-12 max-w-2xl leading-relaxed">
					{siteContent.cta.subtitle}
				</Text>
				<Button
					variant="accent"
					size="lg"
					href={siteContent.cta.primaryButton.href}
				>
					{siteContent.cta.primaryButton.text}
				</Button>
			</div>
		</Container>
	</Section>
</Layout>
