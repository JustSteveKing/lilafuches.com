---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import CallToAction from "../components/CallToAction.astro";
import ClientLogos from "../components/ClientLogos.astro";
import Quote from "../components/Quote.astro";
import { founders, principles, site, testimonials } from "../data/site";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const [featured, ...quotes] = testimonials;
---

<Base>
  <!-- Hero -->
  <section class="shell grid gap-14 pt-16 pb-20 md:pt-24 md:pb-28 lg:grid-cols-[1fr_20rem] lg:items-end lg:gap-20">
    <div>
      <p class="label rise" style="--i:0"><b>Est. {site.founded}</b> A small technical agency</p>
      <h1 class="rise mt-8 text-[3.2rem] leading-[0.98] sm:text-7xl lg:text-[6.4rem]" style="--i:1">
        High-level expertise, <span class="accent">approachably delivered.</span>
      </h1>
      <p class="rise mt-8 max-w-2xl text-lg leading-relaxed text-ink-soft md:text-xl" style="--i:2">
        We help Laravel and API-focused companies grow their product and their team. That means fractional CTO work
        and API architecture, technical content developers actually read, and training that changes how a team works.
      </p>
      <div class="rise mt-10 flex flex-wrap items-center gap-x-8 gap-y-4" style="--i:3">
        <a
          href={site.booking}
          class="group inline-flex items-center gap-3 rounded-full bg-fox px-6 py-3.5 font-medium text-fox-ink transition hover:brightness-110"
        >
          Book a free intro call
          <Arrow class="size-4 transition-transform group-hover:translate-x-1" />
        </a>
        <a href="#services" class="link-quiet text-ink-soft hover:text-ink">See what we do</a>
      </div>
    </div>

    <aside class="rise rounded-2xl border border-rule bg-paper-sunk p-6" style="--i:4" aria-label="Who you work with">
      <div class="flex -space-x-3">
        {founders.map((f) => (
          <img
            src={f.photo}
            alt={f.name}
            width="56"
            height="56"
            class="size-14 rounded-full border-2 border-paper-sunk bg-lilac-wash object-cover"
          />
        ))}
      </div>
      <p class="mt-5 font-display text-2xl leading-tight">You work with the founders.</p>
      <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-soft">
        Steve and Amy McDougall. The people you speak to first are the people who do the work.
      </p>
      <a href="/about" class="mt-4 inline-flex items-center gap-2 text-sm text-lilac">
        <span class="link-quiet">About us</span>
        <Arrow class="size-3.5" />
      </a>
    </aside>
  </section>

  <!-- Clients -->
  <section class="border-y border-rule bg-paper-sunk/60">
    <div class="shell py-10">
      <p class="mb-8 font-mono text-xs uppercase tracking-[0.08em] text-ink-faint">Teams we've worked with</p>
      <ClientLogos />
    </div>
  </section>

  <!-- Services index -->
  <section id="services" class="shell scroll-mt-8 py-20 md:py-28">
    <p class="label"><b>01</b> What we do</p>
    <div class="mt-8 grid gap-6 md:grid-cols-[1fr_1fr] md:items-end">
      <h2 class="text-4xl leading-[1.05] md:text-6xl">Three ways in, <span class="accent">one standard.</span></h2>
      <p class="max-w-md text-lg text-ink-soft md:justify-self-end">
        Whichever you need, it's delivered by the founders, with the precision of a CTO and a team small
        enough to stay approachable.
      </p>
    </div>

    <ol class="mt-14 border-t border-rule-strong">
      {services.map((s) => (
        <li class="border-b border-rule-strong">
          <a
            href={`/${s.id}`}
            class="group grid gap-4 py-8 md:grid-cols-[5rem_1fr_1.2fr_3rem] md:items-baseline md:gap-8 md:py-10"
          >
            <span class="font-mono text-sm text-lilac">{String(s.data.order).padStart(2, "0")}</span>
            <span class="font-display text-4xl leading-none transition-colors group-hover:text-lilac md:text-5xl">
              {s.data.short}
            </span>
            <span class="text-ink-soft">{s.data.summary}</span>
            <span class="hidden justify-self-end text-ink-faint transition group-hover:translate-x-1 group-hover:text-fox md:block">
              <Arrow class="size-6" />
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- Testimonials -->
  <section class="bg-paper-sunk py-20 md:py-28">
    <div class="shell">
      <p class="label"><b>02</b> What clients say</p>
      <div class="mt-12 max-w-4xl">
        <Quote item={featured} size="large" />
      </div>
      <div class="mt-16 grid gap-12 border-t border-rule pt-12 md:grid-cols-3 md:gap-10">
        {quotes.map((q) => <Quote item={q} />)}
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="shell py-20 md:py-28">
    <p class="label"><b>03</b> How we work</p>
    <div class="mt-12 grid gap-x-16 gap-y-12 md:grid-cols-2">
      {principles.map((p, i) => (
        <div class="grid grid-cols-[2.5rem_1fr] gap-4">
          <span class="pt-1.5 font-mono text-sm text-ink-faint">{String.fromCharCode(97 + i)}.</span>
          <div>
            <h3 class="text-2xl md:text-3xl">{p.title}</h3>
            <p class="mt-3 leading-relaxed text-ink-soft">{p.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <CallToAction />
</Base>
