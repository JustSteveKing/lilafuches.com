								>
									Laravel
								</span>
							</div>
							<span
								class="live-indicator mr-2 h-2 w-2 rounded-full bg-red-500"
							></span>
							<span class="text-xs text-red-500">LIVE</span>
							<span class="text-cyan-400 text-xs">
								20 Spots left
							</span>
						</div>
						<span class="text-primary text-sm">→</span>
					</div>
				</div>
			</div>
		</Container>
	</Section>

	<Section id="why" title={"why"}>
		<Container>
			<div class="mb-12 text-center">
				<h2 class="mb-4 text-3xl font-black md:text-5xl">
					Why Developers Trust Us
				</h2>
			</div>

			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
				<div class="text-center">
					<div
						class="bg-gradient-to-r from-primary to-accent bg-clip-text mb-2 text-4xl font-black text-transparent"
					>
						<span
							class="bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent"
						>
							100%
						</span>
					</div>

					<p class="text-gray-400">Developer-First Approach</p>
				</div>

				<div class="text-center">
					<div
						class="bg-gradient-to-r from-primary to-accent bg-clip-text mb-2 text-4xl font-black text-transparent"
					>
						<span
							class="bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent"
