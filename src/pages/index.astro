---
import Layout from "@/layouts/Layout.astro";
import { Container, Section } from "@/components";
---

<Layout>
	<Section id={"hero"} class={"pb-20"} title={"hero"}>
		<Container>
			<div
				class="container py-12 mx-auto mt-px max-w-md text-left sm:max-w-xl sm:px-4 sm:py-12 md:max-w-none md:text-center"
			>
				<h1
					class="text-4xl font-semibold tracking-tight text-left text-gray-900 leading-tighter text-balance sm:mx-auto sm:text-center sm:text-5xl md:max-w-3xl md:text-6xl lg:text-7xl"
				>
					Developer Content That <span class="text-blue-400"
						>Drives Results</span
					>
				</h1>
				<div
					class="mx-auto mt-5 max-w-[80ch] text-gray-400 sm:text-center md:mt-8 md:text-2xl lg:max-w-lg"
				>
					From bite-sized tutorials to in-depth workshops, we create
					technical content that gets developers excited - and helps
					your product grow. Build real developer engagement with
					content, workshops, and strategies that actually work.
				</div>
				<div
					class="flex flex-col justify-center items-center mt-8 space-y-4 font-semibold text-center sm:flex-row sm:space-x-4 sm:space-y-0"
				>
					<span class="inline-flex relative w-full sm:w-auto">
						<a
							href="#_"
							class="inline-flex justify-center items-center px-6 py-3 w-full text-base leading-6 text-white bg-gray-900 rounded-full border border-transparent inset-shadow-xs inset-shadow-white/30 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-800 focus:ring-offset-2 sm:w-auto md:px-9 md:py-4"
						>
							Let's Talk
						</a>
					</span>
				</div>
			</div>
		</Container>
	</Section>

	<Section id={"services"} title={"services"}>
		<Container>
			<div class="mb-12 text-center">
				<h2 class="mb-4 text-3xl font-black md:text-5xl">What We Do</h2>
				<p class="mx-auto max-w-2xl text-xl text-gray-400">
					Developer Relations is more than just writing docs. It's
					about building genuine connections through valuable content.
				</p>
			</div>
			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
				<div
					class="glass hover:border-primary/50 cursor-pointer rounded-xl border border-border p-6 transition-all"
				>
					<div
						class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-gradient-to-br from-primary to-accent"
					>
						<svg
							class="h-6 w-6 text-slate-900"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
							></path>
						</svg>
					</div>
					<h3 class="mb-2 text-xl font-bold">Written Content</h3>
					<p class="text-sm text-gray-400">
						Technical blogs, tutorials, and documentation that
						developers actually want to read.
					</p>
				</div>
				<div
					class="glass hover:border-primary/50 cursor-pointer rounded-xl border border-border p-6 transition-all"
