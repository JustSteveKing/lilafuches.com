---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <section class="shell py-24 md:py-36">
    <p class="label"><b>404</b> Not found</p>
    <h1 class="mt-8 max-w-3xl text-5xl leading-[1.02] md:text-7xl">
      This page has <span class="accent">gone to ground.</span>
    </h1>
    <p class="mt-8 max-w-xl text-lg text-ink-soft">
      It may have moved when the site was rebuilt. Try the <a href="/" class="text-lilac underline underline-offset-4">home page</a>,
      or <a href="/contact" class="text-lilac underline underline-offset-4">get in touch</a> if you were looking for something
      specific.
    </p>
  </section>
</Base>
