---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import CallToAction from "../components/CallToAction.astro";
import Quote from "../components/Quote.astro";
import { site, testimonials } from "../data/site";

export async function getStaticPaths() {
  const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
  return services.map((service, i) => ({
    params: { service: service.id },
    props: { service, next: services[(i + 1) % services.length] },
  }));
}

interface Props {
  service: CollectionEntry<"services">;
  next: CollectionEntry<"services">;
}

const { service, next } = Astro.props;
const { data } = service;
const { Content } = await render(service);
const quote = testimonials.find((t) => t.pillar === service.id);
const number = String(data.order).padStart(2, "0");
---

<Base title={data.title} description={data.description}>
  <section class="shell pt-16 pb-16 md:pt-24 md:pb-24">
    <nav aria-label="Breadcrumb" class="rise font-mono text-xs uppercase tracking-[0.08em] text-ink-faint" style="--i:0">
      <a href="/" class="link-quiet hover:text-ink">Home</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-lilac">{number} {data.short}</span>
    </nav>
    <h1 class="rise mt-8 max-w-5xl text-[3rem] leading-[1] sm:text-6xl lg:text-[5.5rem]" style="--i:1">
      {data.headline} <span class="accent">{data.accent}</span>
    </h1>
    <p class="rise mt-8 max-w-2xl text-lg leading-relaxed text-ink-soft md:text-xl" style="--i:2">{data.summary}</p>
  </section>

  <section class="shell grid gap-14 pb-20 md:pb-28 lg:grid-cols-[1fr_22rem] lg:gap-24">
    <div class="prose-lf max-w-[38rem] text-lg leading-[1.7]">
      <Content />
    </div>

    <aside class="self-start rounded-2xl border border-rule bg-paper-sunk p-6 lg:sticky lg:top-8">
      <p class="font-mono text-xs uppercase tracking-[0.08em] text-ink-faint">A good fit if</p>
      <ul class="mt-4 space-y-3">
        {data.fit.map((item) => (
          <li class="grid grid-cols-[1rem_1fr] gap-2 text-[0.95rem] leading-snug">
            <span class="mt-[0.45em] block size-1.5 rounded-full bg-lilac" aria-hidden="true"></span>
            {item}
          </li>
        ))}
      </ul>
      <a
        href={site.booking}
        class="group mt-6 inline-flex w-full items-center justify-between rounded-full bg-ink px-5 py-3 text-paper transition hover:bg-lilac"
      >
        Talk it through with us
        <Arrow class="size-4 transition-transform group-hover:translate-x-1" />
      </a>
    </aside>
  </section>

  <section class="border-t border-rule">
    <div class="shell py-20 md:py-28">
      <p class="label"><b>{number}</b> What's included</p>
      <dl class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-rule bg-rule md:grid-cols-2">
        {data.offers.map((offer, i) => (
          <div class="bg-paper p-7 md:p-9">
            <dt class="flex items-baseline gap-3">
              <span class="font-mono text-sm text-lilac">{number}.{i + 1}</span>
              <span class="font-display text-2xl md:text-[1.75rem]">{offer.name}</span>
            </dt>
            <dd class="mt-3 leading-relaxed text-ink-soft">{offer.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {quote && (
    <section class="bg-paper-sunk py-20 md:py-24">
      <div class="shell max-w-4xl">
        <Quote item={quote} size="large" />
      </div>
    </section>
  )}

  <section class="shell pt-20">
    <a href={`/${next.id}`} class="group flex flex-wrap items-baseline justify-between gap-4 border-y border-rule-strong py-8">
      <span class="font-mono text-xs uppercase tracking-[0.08em] text-ink-faint">Next: {String(next.data.order).padStart(2, "0")}</span>
      <span class="flex items-center gap-4 font-display text-4xl transition-colors group-hover:text-lilac md:text-5xl">
        {next.data.short}
        <Arrow class="size-7 transition-transform group-hover:translate-x-1" />
      </span>
    </a>
  </section>

  <CallToAction />
</Base>
