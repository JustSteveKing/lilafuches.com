---
import Base from "../layouts/Base.astro";
import CallToAction from "../components/CallToAction.astro";
import { founders, numbers, principles, site } from "../data/site";
---

<Base
  title="About"
  description="Lila Fuches was founded in 2019 by Steve and Amy McDougall: technical leadership paired with operational care, for Laravel and API-focused companies."
>
  <section class="shell pt-16 pb-16 md:pt-24 md:pb-24">
    <p class="label rise" style="--i:0"><b>About</b> Lila Fuches</p>
    <h1 class="rise mt-8 max-w-5xl text-[3rem] leading-[1] sm:text-6xl lg:text-[5.5rem]" style="--i:1">
      Two founders, <span class="accent">one standard of work.</span>
    </h1>
    <div class="rise mt-10 grid max-w-4xl gap-6 text-lg leading-relaxed text-ink-soft md:grid-cols-2 md:gap-10" style="--i:2">
      <p>
        We started Lila Fuches in {site.founded}. The idea is simple: senior technical help that doesn't arrive with
        the overhead of a big consultancy, or vanish behind a junior team once the contract is signed.
      </p>
      <p>
        It's a partnership of technical leadership and operational care. Steve does the engineering, the writing and
        the teaching. Amy makes sure every engagement runs the way it should, from the first call to the last invoice.
      </p>
    </div>
  </section>

  <section class="border-y border-rule bg-paper-sunk">
    <dl class="shell grid grid-cols-2 gap-px md:grid-cols-4">
      {numbers.map((n) => (
        <div class="py-10 md:py-12">
          <dt class="sr-only">{n.label}</dt>
          <dd>
            <span class="block font-display text-5xl text-lilac md:text-6xl">{n.value}</span>
            <span class="mt-2 block text-sm text-ink-soft">{n.label}</span>
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="shell py-20 md:py-28">
    <p class="label"><b>01</b> The founders</p>
    <div class="mt-12 grid gap-16 md:grid-cols-2 md:gap-12">
      {founders.map((f) => (
        <article>
          <div class="aspect-[4/3] overflow-hidden rounded-2xl bg-lilac-wash">
            <img
              src={f.photo}
              alt={`Portrait of ${f.name}`}
              width="640"
              height="480"
              loading="lazy"
              class="size-full object-cover object-top"
            />
          </div>
          <h2 class="mt-6 text-3xl md:text-4xl">{f.name}</h2>
          <p class="mt-1 font-mono text-xs uppercase tracking-[0.08em] text-lilac">{f.role}</p>
          <p class="mt-4 leading-relaxed text-ink-soft">{f.bio}</p>
          <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm">
            {f.links.map((l) => (
              <li><a href={l.href} class="link-quiet">{l.label}</a></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="border-t border-rule">
    <div class="shell py-20 md:py-28">
      <p class="label"><b>02</b> How we work</p>
      <ol class="mt-12 grid gap-x-16 gap-y-10 md:grid-cols-2">
        {principles.map((p, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-4">
            <span class="pt-1.5 font-mono text-sm text-ink-faint">{String.fromCharCode(97 + i)}.</span>
            <div>
              <h3 class="text-2xl md:text-3xl">{p.title}</h3>
              <p class="mt-3 leading-relaxed text-ink-soft">{p.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CallToAction />
</Base>
