---
interface Props {
    name: string;
    logo: string;
    alt: string;
    website: string;
    color?: string;
    class?: string;
}

const {
    name,
    logo,
    alt,
    website,
    color: propColor,
    class: className = "",
} = Astro.props as Props;

// Brand color mapping for the glow effect
const brandColors: Record<string, string> = {
    'hookdeck': '#0044CC',
    'permit.io': '#FF953F',
    'sevalla': '#F97316',
    'tighten': '#FFBC01',
    'warp': '#202020',
    'zuplo': '#FF24BD',
};

const brandColor = propColor || brandColors[name.toLowerCase()] || '#888';
---

<a
    href={website}
    target="_blank"
    rel="noopener noreferrer"
    class={`group relative flex items-center justify-center p-4 transition-all duration-500 hover:scale-110 ${className}`}
    aria-label={`Visit ${name} website`}
    title={`Visit ${name} website.`}
>
    <!-- Background Glow -->
    <div
        class="absolute inset-0 opacity-0 group-hover:opacity-15 dark:group-hover:opacity-20 blur-2xl transition-opacity duration-500 rounded-full"
        style={`background-color: ${brandColor}`}
    ></div>

    <img
        src={logo}
        alt={alt}
        class="h-7 md:h-8 w-auto transition-all duration-500 logo-filter relative z-10"
        style={`--brand-glow: ${brandColor}`}
        loading="lazy"
        decoding="async"
    />
</a>

<style>
    .logo-filter {
        filter: grayscale(1) opacity(0.5);
    }

    :global(.dark) .logo-filter {
        /* Invert grayscale logos in dark mode so they are visible (white-ish) */
        filter: grayscale(1) invert(1) brightness(1.5) opacity(0.4);
    }

    .group:hover .logo-filter {
        filter: grayscale(0) opacity(1) drop-shadow(0 0 10px var(--brand-glow));
    }

    :global(.dark) .group:hover .logo-filter {
        /* Remove inversion on hover to show original brand colors */
        filter: grayscale(0) invert(0) brightness(1) opacity(1) drop-shadow(0 0 15px var(--brand-glow));
    }
</style>
