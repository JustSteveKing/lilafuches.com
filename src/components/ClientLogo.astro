---
interface Props {
    name: string;
    logo: string;
    alt: string;
    website: string;
    color?: string;
    class?: string;
}

const {
    name,
    logo,
    alt,
    website,
    color: propColor,
    class: className = "",
} = Astro.props as Props;

// Brand color mapping for the glow effect
const brandColors: Record<string, string> = {
    'hookdeck': '#0044CC',
    'permit.io': '#FF953F',
    'sevalla': '#F97316',
    'tighten': '#FFBC01',
    'warp': '#202020',
    'zuplo': '#FF24BD',
};

const brandColor = propColor || brandColors[name.toLowerCase()] || '#888';
---

<a
    href={website}
    target="_blank"
    rel="noopener noreferrer"
    class={`group relative flex items-center justify-center p-4 transition-all duration-500 ${className}`}
    aria-label={`Visit ${name} website`}
    title={`Visit ${name} website.`}
>
    <img
        src={logo}
        alt={alt}
        class="h-8 md:h-9 w-auto logo-filter relative z-10"
        loading="lazy"
        decoding="async"
    />
</a>

<style>
    .logo-filter {
        filter: grayscale(1) opacity(0.4);
        transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    :global(.dark) .logo-filter {
        filter: grayscale(1) invert(1) brightness(2) opacity(0.35);
    }

    .group:hover .logo-filter {
        filter: grayscale(0) opacity(1);
    }

    :global(.dark) .group:hover .logo-filter {
        filter: grayscale(0) invert(1) hue-rotate(180deg) brightness(1.5) opacity(1);
    }
</style>
