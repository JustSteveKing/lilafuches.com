---
import clsx from "clsx";

interface Props {
    id: string;
    title: string;
    class?: string;
}

const {
    id,
    title,
    class: className = "",
} = Astro.props as Props;
---

<section id={id} aria-labelledby={`${id}-heading`} class={clsx(className, "px-4 py-12 w-full")}>
    <slot />
</section>