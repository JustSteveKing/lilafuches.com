---
// Theme toggle component with improved accessibility
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  aria-describedby="theme-toggle-description"
  class="inline-flex items-center justify-center w-10 h-10 p-2 rounded-lg transition-all duration-200 bg-gray-100 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700 focus-ring relative z-10"
>
  <!-- Sun icon (visible in dark mode) -->
  <svg
    class="w-5 h-5 text-gray-700 dark:text-gray-300 dark:hidden"
    fill="none"
    stroke="currentColor" 
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path 
      stroke-linecap="round" 
      stroke-linejoin="round" 
      stroke-width="2" 
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    />
  </svg>
  
  <!-- Moon icon (visible in light mode) -->
  <svg
    class="w-5 h-5 text-gray-700 dark:text-gray-300 hidden dark:block"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path 
      stroke-linecap="round" 
      stroke-linejoin="round" 
      stroke-width="2" 
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
    />
  </svg>
</button>

<span id="theme-toggle-description" class="sr-only">
  Switch between light and dark mode
</span>

<script>
  // Theme toggle functionality
  document.addEventListener('DOMContentLoaded', () => {
    const themeToggle = document.getElementById('theme-toggle');
    
    if (themeToggle) {
      themeToggle.addEventListener('click', (e) => {
        // Stop all event propagation
        e.stopPropagation();
        e.stopImmediatePropagation();
        
        // Call the global toggleTheme function
        if (typeof (window as any).toggleTheme === 'function') {
          (window as any).toggleTheme();
        }
        
        // Update aria-label based on current theme
        const isDark = document.documentElement.classList.contains('dark');
        themeToggle.setAttribute('aria-label', 
          isDark ? 'Switch to light mode' : 'Switch to dark mode'
        );
      }, true); // Use capture phase
      
      // Update initial aria-label
      const isDark = document.documentElement.classList.contains('dark');
      themeToggle.setAttribute('aria-label', 
        isDark ? 'Switch to light mode' : 'Switch to dark mode'
      );
      
      // Listen for theme changes to update aria-label
      window.addEventListener('themeChanged', (e: any) => {
        const isDark = e.detail.theme === 'dark';
        themeToggle.setAttribute('aria-label', 
          isDark ? 'Switch to light mode' : 'Switch to dark mode'
        );
      });
    }
  });
</script>
