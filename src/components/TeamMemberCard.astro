---
import Heading from "./Heading.astro";
import Text from "./Text.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

interface Props {
    name: string;
    avatar: string;
    role: string;
    description: string;
    socialLinks?: { url: string; platform: string }[];
}

const { name, avatar, role, description, socialLinks = [] } = Astro.props as Props;

// Map platform names to icon names
const iconMap: Record<string, string> = {
  twitter: "mdi:twitter",
  github: "mdi:github",
  linkedin: "mdi:linkedin",
  website: "mdi:web",
};
---

<article class="card flex flex-col items-center group bg-stone-100 dark:bg-stone-700 dark:border-stone-800">
  <figure class="mb-6 h-28 w-28 overflow-hidden rounded-full border-4 border-stone-100 dark:border-stone-800 shadow-sm transition-transform duration-300 group-hover:scale-105">
    <Image src={avatar} alt={name} height={112} width={112} loading="lazy" decoding="async" class="h-full w-full object-cover" />
  </figure>
  <Heading level={3} class="mb-1 text-2xl font-bold text-stone-900 dark:text-stone-100">{name}</Heading>
  <div class="mb-4 text-sm font-bold uppercase tracking-wider text-accent dark:text-orange-400">
    {role}
  </div>
  <Text class="mb-6 text-center text-stone-600 dark:text-stone-400 leading-relaxed">{description}</Text>
  <nav class="flex items-center justify-center space-x-5" aria-label={`Social links for ${name}`}>
    {socialLinks.map((link) => (
      <a href={link.url} target="_blank" rel="noopener" aria-label={link.platform} class="text-stone-400 hover:text-stone-800 dark:hover:text-stone-200 transition-all duration-300 hover:scale-110">
        <Icon name={iconMap[link.platform] || "mdi:link"} class="h-5 w-5" />
      </a>
    ))}
  </nav>
</article>
