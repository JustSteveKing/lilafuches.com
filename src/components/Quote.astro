---
import type { Testimonial } from "../data/site";

interface Props {
  item: Testimonial;
  size?: "large" | "small";
}

const { item, size = "small" } = Astro.props;
---

<figure class="flex h-full flex-col">
  <blockquote
    class:list={[
      "font-display leading-snug",
      size === "large" ? "text-[1.7rem] md:text-[2.35rem] md:leading-[1.2]" : "text-xl",
    ]}
  >
    <span class="text-lilac" aria-hidden="true">&ldquo;</span>{item.quote}<span class="text-lilac" aria-hidden="true">&rdquo;</span>
  </blockquote>
  <figcaption class="mt-auto flex items-center gap-3 pt-6">
    <img
      src={item.avatar}
      alt=""
      width="40"
      height="40"
      loading="lazy"
      decoding="async"
      class="size-10 rounded-full bg-paper-sunk object-cover grayscale"
    />
    <span class="text-sm leading-tight">
      <span class="block font-medium">{item.name}</span>
      <span class="text-ink-soft">{item.role}, {item.company}</span>
    </span>
  </figcaption>
</figure>
