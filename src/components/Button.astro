---
const { variant = "primary", size = "md", href = undefined, class: className = "", ...rest } = Astro.props;

const base = "inline-flex items-center justify-center font-bold uppercase tracking-widest border border-transparent transition-all duration-300 focus-ring disabled:opacity-50 disabled:cursor-not-allowed select-none rounded-full";

const sizes = {
  sm: "px-4 py-2 text-xs",
  md: "px-6 py-3 text-sm",
  lg: "px-8 py-3.5 text-base",
};

const variants = {
  primary: "bg-primary text-primary-foreground hover:bg-primary/90",
  
  secondary: "bg-muted text-foreground hover:bg-muted/80",
  
  accent: "bg-accent text-accent-foreground hover:bg-accent/90",
  
  outline: "bg-transparent border-border text-foreground hover:bg-muted hover:border-accent hover:text-foreground",
  
  ghost: "bg-transparent text-foreground hover:bg-muted hover:text-accent",
  
  link: "bg-transparent text-primary underline-offset-4 hover:underline p-0 h-auto border-none rounded-none",
  
  destructive: "bg-red-600 text-white hover:bg-red-700",
};

const classes = `${base} ${sizes[size as keyof typeof sizes]} ${variants[variant as keyof typeof variants] || variants.primary} ${className}`;
---

{href ? (
  <a href={href} class={classes} {...rest}>
    <slot />
  </a>
) : (
  <button type="button" class={classes} {...rest}>
    <slot />
  </button>
)}
