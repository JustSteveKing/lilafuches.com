---
const { variant = "primary", size = "md", href = undefined, class: className = "", ...rest } = Astro.props;

const base = "inline-flex items-center justify-center font-bold uppercase tracking-widest border-2 border-border transition-all duration-200 focus-ring disabled:opacity-50 disabled:cursor-not-allowed select-none rounded-md";

const sizes = {
  sm: "px-4 py-2 text-xs",
  md: "px-6 py-3 text-sm",
  lg: "px-8 py-3.5 text-base",
};

const variants = {
  primary: "bg-primary text-primary-foreground hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[3px_3px_0px_0px_rgba(0,0,0,0.1)] dark:hover:shadow-[3px_3px_0px_0px_rgba(255,255,255,0.1)]",
  
  secondary: "bg-background text-foreground hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[3px_3px_0px_0px_rgba(0,0,0,0.1)] dark:hover:shadow-[3px_3px_0px_0px_rgba(255,255,255,0.1)]",
  
  accent: "bg-accent text-accent-foreground border-accent hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[3px_3px_0px_0px_rgba(255,87,34,0.2)]",
  
  outline: "bg-transparent text-foreground hover:bg-muted",
  
  ghost: "bg-transparent text-foreground border-transparent hover:border-border hover:bg-muted",
  
  link: "bg-transparent text-primary underline-offset-4 hover:underline p-0 h-auto border-none",
  
  destructive: "bg-red-600 text-white border-red-700 hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]",
};

const classes = `${base} ${sizes[size as keyof typeof sizes]} ${variants[variant as keyof typeof variants] || variants.primary} ${className}`;
---

{href ? (
  <a href={href} class={classes} {...rest}>
    <slot />
  </a>
) : (
  <button type="button" class={classes} {...rest}>
    <slot />
  </button>
)}
