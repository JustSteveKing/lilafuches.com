---
import Heading from "./Heading.astro";
import Text from "./Text.astro";

interface Props {
  title: string;
  description: string;
  class?: string;
}

const { title, description, class: className = "" } = Astro.props as Props;
---

<div class={`card group dark:bg-stone-900 dark:border-stone-800 ${className}`} role="article">
  <div class="flex items-start space-x-3">
    <div class="mt-1 h-5 w-5 flex-shrink-0 text-accent dark:text-orange-400 group-hover:scale-110 transition-transform duration-200">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <div>
      <Heading level={4} class="text-lg font-bold mb-1 text-stone-900 dark:text-stone-100 group-hover:text-stone-800 dark:group-hover:text-white transition-colors duration-200">
        {title}
      </Heading>
      <Text class="text-sm text-stone-600 dark:text-stone-400 leading-relaxed group-hover:text-stone-700 dark:group-hover:text-stone-300 transition-colors duration-300">
        {description}
      </Text>
    </div>
  </div>
</div>
