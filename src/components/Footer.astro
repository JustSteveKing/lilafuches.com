---
import { siteContent } from "@/utils/siteContent";
import Container from "./Container.astro";
import Logo from "./Logo.astro";
import { Icon } from "astro-icon/components";

const date: Date = new Date();

const iconMap: Record<string, string> = {
  Twitter: "mdi:twitter",
  GitHub: "mdi:github",
  LinkedIn: "mdi:linkedin",
  Contact: "mdi:email",
};
---

<footer class="mt-32 border-t border-border bg-background">
    <Container>
        <div class="py-24">
            <div class="grid md:grid-cols-12 gap-12">
                <!-- Left: Brand & Navigation -->
                <div class="md:col-span-6 flex flex-col items-start gap-y-12">
                    <a href="/" class="focus-ring border border-border/20 p-4 hover:bg-accent/5 transition-all duration-300 rounded-lg">
                        <Logo class="h-8 w-auto text-foreground" />
                    </a>
                    
                    <nav class="flex flex-col gap-y-3">
                        {siteContent.navigation.menuItems.map(item => (
                            <a href={item.href} class="text-lg font-black uppercase tracking-[0.2em] text-foreground hover:text-accent transition-colors duration-200">
                                {item.label}
                            </a>
                        ))}
                    </nav>
                </div>

                <!-- Right: Social & Contact -->
                <div class="md:col-span-6 flex flex-col items-start md:items-end gap-y-12">
                    <div class="grid grid-cols-2 gap-3 w-full md:w-auto">
                        {siteContent.footer.links.map(link => (
                            <a 
                                href={link.href} 
                                target="_blank" 
                                rel="noopener" 
                                aria-label={link.label}
                                class="flex items-center justify-center border border-border/20 p-5 hover:bg-accent hover:text-accent-foreground transition-all duration-300 rounded-lg"
                            >
                                <Icon name={iconMap[link.label] || "mdi:link"} class="h-6 w-6" />
                            </a>
                        ))}
                    </div>
                    
                    <a 
                      href={`mailto:${siteContent.site.email}`}
                      class="text-xl font-black uppercase tracking-tighter text-foreground hover:bg-accent hover:text-accent-foreground border border-border/20 p-4 transition-all duration-300 rounded-lg"
                    >
                      {siteContent.site.email}
                    </a>
                </div>
            </div>

            <!-- Bottom: Legal -->
            <div class="mt-24 pt-12 border-t border-border/10 flex flex-col md:flex-row justify-between items-start md:items-end gap-y-8 md:gap-y-0 text-[10px] font-black uppercase tracking-widest text-muted-foreground">
                <div class="flex flex-col items-start gap-y-2">
                    <p>
                        &copy; {siteContent.company.founded} — {date.getFullYear()} {siteContent.company.name}
                    </p>
                    <p class="opacity-50">
                        No. 12171927 • Registered in England & Wales
                    </p>
                </div>
                
                <div class="flex items-center gap-x-8">
                    <a href="/sitemap.xml" class="hover:text-foreground transition-colors">Sitemap</a>
                    <span class="bg-foreground text-background px-3 py-1 rounded text-[9px]">
                        Astro 6.0
                    </span>
                </div>
            </div>
        </div>
    </Container>
</footer>
