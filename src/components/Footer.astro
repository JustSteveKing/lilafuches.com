---
import Logo from "./Logo.astro";
import { nav, site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-rule">
  <div class="shell grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-sm">
      <Logo />
      <p class="mt-4 text-ink-soft">{site.tagline}</p>
    </div>

    <div>
      <p class="font-mono text-xs uppercase tracking-[0.08em] text-ink-faint">Pages</p>
      <ul class="mt-4 space-y-2">
        {nav.map((item) => (
          <li><a href={item.href} class="link-quiet">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="font-mono text-xs uppercase tracking-[0.08em] text-ink-faint">Talk to us</p>
      <ul class="mt-4 space-y-2">
        <li><a href={`mailto:${site.email}`} class="link-quiet">{site.email}</a></li>
        <li><a href={site.booking} class="link-quiet">Book an intro call</a></li>
        <li><a href={site.linkedin} class="link-quiet">LinkedIn</a></li>
      </ul>
    </div>
  </div>

  <div class="shell flex flex-col gap-2 border-t border-rule py-6 font-mono text-xs text-ink-faint sm:flex-row sm:justify-between">
    <p>&copy; {year} {site.legalName}.</p>
    <p>Founded {site.founded}. Working with teams everywhere.</p>
  </div>
</footer>
