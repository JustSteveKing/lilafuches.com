---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { siteContent } from "@/utils/siteContent";
---

<section 
  x-data="{ showMenu: false, scrolled: false }" 
  x-init="window.addEventListener('scroll', () => { scrolled = window.scrollY > 20 })"
  x-effect="document.body.classList.toggle('overflow-hidden', showMenu)" 
  class="fixed top-0 left-0 right-0 z-50 px-4 sm:px-6 transition-all duration-300"
  :class="scrolled ? 'glass-nav h-16' : 'h-20 bg-transparent'"
>
    <div class="mx-auto max-w-7xl h-full">
        <nav class="relative z-50 h-full select-none" role="navigation" aria-label="Main navigation">
            <div class="flex overflow-hidden relative justify-between items-center mx-auto h-full font-medium px-2 sm:px-4">
                <!-- Logo -->
                <div class="flex justify-start items-center pr-2 h-full min-w-0 flex-shrink-0">
                    <a 
                      href="/" 
                      title="Lila Fuches - Home" 
                      aria-label="Lila Fuches home page"
                      class="flex items-center focus-ring rounded-lg p-1 -m-1 transition-all duration-200 group"
                    >
                        <Logo 
                          class="h-8 sm:h-9 w-auto text-stone-900 dark:text-stone-100 transition-all duration-300" 
                          :class="scrolled ? 'sm:h-7' : 'sm:h-9'"
                        />
                    </a>
                </div>

                <!-- Desktop Navigation -->
                <div class="hidden md:flex flex-1 justify-center items-center space-x-2 min-w-0">
                    {siteContent.navigation.menuItems.map((item) => (
                        <a 
                          href={item.href} 
                          class="text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-white transition-all duration-200 font-bold uppercase tracking-widest text-[10px] sm:text-xs px-3 py-2 rounded-md hover:bg-stone-100/50 dark:hover:bg-stone-800/50"
                        >
                            {item.label}
                        </a>
                    ))}
                </div>

                <!-- Mobile Menu Button -->
                <div class="flex items-center flex-shrink-0">
                    <button
                      @click.stop="showMenu = !showMenu"
                      type="button"
                      aria-label="Toggle navigation menu"
                      aria-expanded="false"
                      x-bind:aria-expanded="showMenu"
                      class="md:hidden inline-flex items-center justify-center w-9 h-9 p-2 rounded-lg transition-all duration-200 bg-stone-100 dark:bg-stone-800 hover:bg-stone-200 dark:hover:bg-stone-700 border border-stone-200 dark:border-stone-700 focus-ring group"
                    >
                        <svg 
                          x-show="!showMenu" 
                          class="w-5 h-5 text-stone-600 dark:text-stone-400" 
                          fill="none" 
                          stroke="currentColor" 
                          stroke-width="2" 
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                        <svg 
                          x-show="showMenu" 
                          class="w-5 h-5 text-stone-600 dark:text-stone-400" 
                          fill="none" 
                          stroke="currentColor" 
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>
        </nav>

        <!-- Mobile Menu Overlay -->
        <div 
          x-show="showMenu"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 -translate-y-4"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-200"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 -translate-y-4"
          class="md:hidden absolute top-full left-4 right-4 mt-2 p-4 rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 shadow-2xl overflow-hidden"
          @click.outside="showMenu = false"
        >
            <div class="sm:hidden mb-4 pb-4 border-b border-stone-100 dark:border-stone-800 flex justify-between items-center">
                <span class="text-xs font-bold uppercase tracking-widest text-stone-400 dark:text-stone-500">Menu</span>
            </div>
            
            <nav class="relative z-10 flex flex-col space-y-1" role="menu" aria-label="Mobile navigation menu">
                {siteContent.navigation.menuItems.map((item) => (
                    <a 
                      href={item.href} 
                      @click="showMenu = false"
                      role="menuitem"
                      class="text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-white transition-all duration-200 font-bold uppercase tracking-widest text-xs px-4 py-4 rounded-lg hover:bg-stone-50 dark:hover:bg-stone-800"
                    >
                        {item.label}
                    </a>
                ))}
            </nav>
        </div>
    </div>
</section>
