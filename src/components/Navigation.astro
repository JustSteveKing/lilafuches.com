---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { siteContent } from "@/utils/siteContent";
---

<section 
  x-data="{ showMenu: false, scrolled: false }" 
  x-init="window.addEventListener('scroll', () => { scrolled = window.scrollY > 20 })"
  x-effect="document.body.classList.toggle('overflow-hidden', showMenu)" 
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  :class="scrolled ? 'glass-nav h-16' : 'h-20 bg-transparent'"
>
    <div class="h-full border-b border-border/10">
        <nav class="relative z-50 h-full select-none mx-auto max-w-7xl px-4 sm:px-6" role="navigation" aria-label="Main navigation">
            <div class="flex overflow-hidden relative justify-between items-center mx-auto h-full font-bold">
                <!-- Logo -->
                <div class="flex justify-start items-center h-full min-w-0 flex-shrink-0">
                    <a 
                      href="/" 
                      title="Lila Fuches - Home" 
                      aria-label="Lila Fuches home page"
                      class="flex items-center focus-ring p-1 -m-1 transition-all duration-200 group border-r border-border/10 h-full pr-8"
                    >
                        <Logo 
                          class="h-7 w-auto text-foreground transition-all duration-300" 
                        />
                    </a>
                </div>

                <!-- Desktop Navigation -->
                <div class="hidden md:flex flex-1 justify-center items-center h-full min-w-0">
                    {siteContent.navigation.menuItems.map((item) => (
                        <a 
                          href={item.href} 
                          class="text-foreground hover:bg-accent/5 hover:text-accent transition-all duration-200 font-black uppercase tracking-[0.2em] text-[10px] h-full flex items-center px-8 border-r border-border/10 last:border-r-0"
                        >
                            {item.label}
                        </a>
                    ))}
                </div>

                <!-- Mobile Menu Button -->
                <div class="flex items-center flex-shrink-0 h-full pl-4">
                    <button
                      @click.stop="showMenu = !showMenu"
                      type="button"
                      aria-label="Toggle navigation menu"
                      aria-expanded="false"
                      x-bind:aria-expanded="showMenu"
                      class="md:hidden inline-flex items-center justify-center w-11 h-11 border border-border/10 rounded-full focus-ring group transition-all duration-300 hover:bg-muted"
                    >
                        <svg 
                          x-show="!showMenu" 
                          class="w-5 h-5 text-foreground/70" 
                          fill="none" 
                          stroke="currentColor" 
                          stroke-width="2" 
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 8h16M4 16h16" />
                        </svg>
                        <svg 
                          x-show="showMenu" 
                          class="w-5 h-5 text-foreground/70" 
                          fill="none" 
                          stroke="currentColor" 
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>
        </nav>

        <!-- Mobile Menu Overlay -->
        <div 
          x-show="showMenu"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-200"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 translate-y-2"
          class="md:hidden absolute top-full left-4 right-4 mt-3 border border-border/10 bg-background/95 backdrop-blur-xl rounded-2xl shadow-2xl overflow-hidden"
          @click.outside="showMenu = false"
        >
            <nav class="relative z-10 flex flex-col p-2" role="menu" aria-label="Mobile navigation menu">
                {siteContent.navigation.menuItems.map((item) => (
                    <a 
                      href={item.href} 
                      @click="showMenu = false"
                      role="menuitem"
                      class="text-foreground/80 hover:bg-accent/5 hover:text-accent rounded-xl transition-all duration-300 font-bold uppercase tracking-[0.2em] text-[10px] px-6 py-5"
                    >
                        {item.label}
                    </a>
                ))}
            </nav>
        </div>
    </div>
</section>
