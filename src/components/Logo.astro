---
// The LF monogram from the original mark, with the wordmark set in the display face.
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2.5", className]}>
  <svg viewBox="0 0 229 268" class="h-7 w-auto text-lilac" aria-hidden="true">
    <g transform="translate(0 -27)">
      <rect height="219" rx="31" stroke="currentColor" stroke-width="22" width="207" x="11" y="38" fill="none"></rect>
      <path d="m52 69h22v158h-22z" fill="currentColor"></path>
      <path d="m52 206h98v21h-98zm41-137h23v122h-23z" fill="currentColor"></path>
      <path d="m93 69h85v21h-85zm0 62h83v20h-83z" fill="currentColor"></path>
    </g>
  </svg>
  <span class="font-display text-[1.35rem] leading-none tracking-[-0.02em]">
    Lila <span class="italic">Fuches</span>
  </span>
</span>
