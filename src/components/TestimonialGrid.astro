---
import Text from "./Text.astro";
import Accent from "./Accent.astro";

interface Testimonial {
  quote: string;
  author: string;
  company: string;
  role: string;
  avatar?: string;
}

interface Props {
  testimonials: Testimonial[];
  columns?: 2 | 3 | 4;
  class?: string;
}

const { 
  testimonials, 
  columns = 2,
  class: className = "" 
} = Astro.props as Props;

const gridCols = {
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-2 lg:grid-cols-3',
  4: 'md:grid-cols-2 lg:grid-cols-4'
};
---

<div class={`grid gap-24 ${gridCols[columns]} ${className}`} role="list" aria-label="Customer testimonials">
  {testimonials.map((testimonial) => (
    <article 
      class="flex flex-col group border-l-2 border-border/20 pl-8"
      role="listitem"
    >
      <blockquote class="flex-1 flex flex-col">
        <div class="flex-1">
          <Text class="text-xl md:text-2xl font-bold text-foreground leading-tight tracking-tight mb-8 uppercase italic">
            {testimonial.quote}
          </Text>
        </div>
        
        <footer class="mt-auto border-t border-border/10 pt-6">
          <cite class="not-italic flex items-center gap-4">
            {testimonial.avatar && (
              <div class="flex-shrink-0 w-12 h-12 border border-border/20 overflow-hidden grayscale contrast-125 rounded">
                <img 
                  src={testimonial.avatar} 
                  alt={`${testimonial.author}`}
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            
            <div class="flex-1 min-w-0">
              <div class="font-black text-sm uppercase tracking-tight text-foreground">{testimonial.author}</div>
              <div class="text-[10px] font-mono uppercase tracking-[0.2em] text-muted-foreground mt-1">
                {testimonial.role} <span class="mx-2 text-accent">|</span> {testimonial.company}
              </div>
            </div>
          </cite>
        </footer>
      </blockquote>
    </article>
  ))}
</div>

<style>
  /* Staggered snappy animation on load */
  [role="listitem"] {
    animation: reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: both;
  }

  [role="listitem"]:nth-child(1) { animation-delay: 0.1s; }
  [role="listitem"]:nth-child(2) { animation-delay: 0.2s; }
  [role="listitem"]:nth-child(3) { animation-delay: 0.3s; }

  @keyframes reveal {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
</style>
