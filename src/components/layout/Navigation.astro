---
import { Button, Logo, ThemeToggle } from "@/components";
import { siteContent } from "@/utils/siteContent";
---

<section
  x-data="{ showMenu: false }"
  x-effect="document.body.classList.toggle('overflow-hidden', showMenu)"
  class="fixed top-0 left-0 right-0 z-50 px-6 glass-nav"
>
    <div class="mx-auto max-w-7xl">
        <nav class="relative z-50 h-20 select-none" role="navigation" aria-label="Main navigation">
            <div class="flex overflow-hidden relative flex-wrap justify-between items-center mx-auto h-20 font-medium sm:px-4 md:overflow-visible md:px-2">
                <!-- Logo -->
                <div class="flex justify-start items-center pr-4 h-full">
                    <a
                      href="/"
                      title="Lila Fuches - Home"
                      aria-label="Lila Fuches home page"
                      class="flex items-center focus-ring rounded-lg p-1 -m-1 transition-all duration-200 group"
                    >
                        <Logo class="h-10 w-auto text-stone-900 dark:text-stone-50 transition-all duration-200 group-hover:drop-shadow-lg" />
                    </a>
                </div>

                <!-- Desktop Navigation -->
                <div class="hidden md:flex flex-1 justify-center items-center space-x-8">
                    {siteContent.navigation.menuItems.map((item, index) => {
                        const colors = [
                            { text: "group-hover:text-engineering dark:group-hover:text-slate-50", bg: "from-engineering/15 to-engineering/5", shadow: "group-hover:shadow-engineering/20" },
                            { text: "group-hover:text-content dark:group-hover:text-slate-50", bg: "from-content/15 to-content/5", shadow: "group-hover:shadow-content/20" },
                            { text: "group-hover:text-education dark:group-hover:text-slate-50", bg: "from-education/15 to-education/5", shadow: "group-hover:shadow-education/20" },
                            { text: "group-hover:text-accent-500 dark:group-hover:text-slate-50", bg: "from-accent-500/15 to-accent-600/5", shadow: "group-hover:shadow-accent-500/20" }
                        ];
                        const color = colors[index % colors.length];

                        return (
                            <a
                              href={item.href}
                              class={`relative text-foreground transition-all duration-200 font-medium focus-ring rounded-lg px-3 py-2 group hover:bg-stone-100/50 dark:hover:bg-stone-800/50 ${color.text} ${color.shadow}`}
                            >
                                <span class="relative z-10">{item.label}</span>
                                <div class={`absolute inset-0 rounded-lg bg-gradient-to-r ${color.bg} opacity-0 group-hover:opacity-100 transition-opacity duration-200`}></div>
                            </a>
                        );
                    })}
                </div>

                <!-- Theme Toggle, CTA & Mobile Menu Button -->
                <div class="flex items-center space-x-3">
                    <div class="hidden sm:block">
                        <Button variant="accent" size="sm" href={siteContent.hero.primaryCTA.href}>
                            Book a Call
                        </Button>
                    </div>

                    <div @click.stop>
                        <ThemeToggle />
                    </div>

                    <!-- Mobile Menu Button -->
                    <button
                      @click.stop="showMenu = !showMenu"
                      type="button"
                      aria-label="Toggle navigation menu"
                      aria-expanded="false"
                      x-bind:aria-expanded="showMenu"
                      class="md:hidden inline-flex items-center justify-center w-10 h-10 p-2 rounded-lg transition-all duration-200 bg-muted/50 hover:bg-muted border border-border/30 hover:border-border focus-ring group"
                    >
                        <div class="absolute inset-0 rounded-lg bg-gradient-to-br from-primary/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
                        <svg
                          x-show="!showMenu"
                          class="relative w-5 h-5 transition-transform duration-200 group-hover:scale-105"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                        <svg
                          x-show="showMenu"
                          class="relative w-5 h-5 transition-transform duration-200 group-hover:scale-105"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>
        </nav>

        <!-- Mobile Menu Overlay -->
        <div
          x-show="showMenu"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 scale-95"
          x-transition:enter-end="opacity-1 scale-100"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-1 scale-100"
          x-transition:leave-end="opacity-0 scale-95"
          class="md:hidden absolute top-full left-0 right-0 mx-6 p-4 rounded-b-xl border border-border bg-stone-50 dark:bg-stone-900 shadow-xl overflow-hidden"
          @click.outside="showMenu = false"
        >
            <!-- Subtle background decoration -->
            <div class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-primary/5 pointer-events-none" aria-hidden="true"></div>

            <nav class="relative z-10 flex flex-col space-y-1" role="menu" aria-label="Mobile navigation menu">
                {siteContent.navigation.menuItems.map((item, index) => {
                    const colors = [
                        { text: "group-hover:text-engineering dark:group-hover:text-slate-50", bg: "from-engineering/15 to-engineering/5", shadow: "group-hover:shadow-engineering/10" },
                        { text: "group-hover:text-content dark:group-hover:text-slate-50", bg: "from-content/15 to-content/5", shadow: "group-hover:shadow-content/10" },
                        { text: "group-hover:text-education dark:group-hover:text-slate-50", bg: "from-education/15 to-education/5", shadow: "group-hover:shadow-education/10" },
                        { text: "group-hover:text-accent-500 dark:group-hover:text-slate-50", bg: "from-accent-500/15 to-accent-600/5", shadow: "group-hover:shadow-accent-500/10" }
                    ];
                    const color = colors[index % colors.length];

                    return (
                        <a
                          href={item.href}
                          @click="showMenu = false"
                          role="menuitem"
                          class={`relative text-foreground hover:bg-stone-100/50 dark:hover:bg-stone-800/50 transition-all duration-200 font-medium rounded-lg px-3 py-3 text-left focus-ring group ${color.text} ${color.shadow}`}
                        >
                            <span class="relative z-10">{item.label}</span>
                            <div class={`absolute inset-0 rounded-lg bg-gradient-to-r ${color.bg} opacity-0 group-hover:opacity-100 transition-opacity duration-200`}></div>
                        </a>
                    );
                })}
            </nav>
        </div>

        <!-- Navigation border -->
        <div class="w-full h-px bg-gradient-to-r from-transparent via-border to-transparent"></div>
    </div>
</section>
