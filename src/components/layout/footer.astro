---
import { siteContent } from "@/utils/siteContent";
import { Container } from "@/components";
import Logo from "@/components/blocks/Logo.astro";

const date: Date = new Date();
---

<footer class="px-4 py-4 w-full relative mt-20 border-t border-border/50 bg-gradient-to-b from-background to-muted/20" id="footer" aria-labelledby="footer" title="Footer">
    <!-- Subtle background decoration -->
    <div class="absolute inset-0 bg-gradient-to-r from-blue-500/5 via-transparent to-purple-500/5 pointer-events-none"></div>
    
    <Container>
        <div class="relative py-12">
            <!-- Main footer content -->
            <div class="flex flex-col items-center space-y-8 md:flex-row md:justify-between md:space-y-0">
                <!-- Logo and company info -->
                <div class="flex flex-col items-center md:items-start space-y-4">
                    <Logo class="h-10 w-auto" />
                    <div class="text-center md:text-left">
                        <p class="text-sm text-muted-foreground font-medium">
                            &copy; {siteContent.company.founded} - {date.getFullYear()} {siteContent.company.name}
                        </p>
                        <p class="text-xs text-muted-foreground/70">
                            All rights reserved. Built with care.
                        </p>
                    </div>
                </div>

                <!-- Social links with enhanced styling -->
                <div class="flex flex-col items-center md:items-end space-y-3">
                    <span class="text-xs text-muted-foreground/70 font-medium">Follow & Connect</span>
                    <div class="flex items-center space-x-3">
                        <a 
                            href={siteContent.footer.links.find(link => link.label === 'Twitter')?.href || '#'} 
                            title="Follow on Twitter" 
                            aria-label="Follow on Twitter"
                            class="group relative p-3 rounded-xl bg-muted/30 border border-border/30 hover:border-blue-500/50 hover:bg-blue-500/5 transition-all duration-200 hover:scale-105"
                            target="_blank" 
                            rel="noopener noreferrer"
                        >
                            <div class="absolute inset-0 rounded-xl bg-gradient-to-br from-blue-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
                            <svg
                                class="relative fill-current text-muted-foreground group-hover:text-blue-500 transition-colors duration-200"
                                width="16"
                                height="16"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M16 3c-.6.3-1.2.4-1.9.5.7-.4 1.2-1 1.4-1.8-.6.4-1.3.6-2.1.8-.6-.6-1.5-1-2.4-1-1.7 0-3.2 1.5-3.2 3.3 0 .3 0 .5.1.7-2.7-.1-5.2-1.4-6.8-3.4-.3.5-.4 1-.4 1.7 0 1.1.6 2.1 1.5 2.7-.5 0-1-.2-1.5-.4C.7 7.7 1.8 9 3.3 9.3c-.3.1-.6.1-.9.1-.2 0-.4 0-.6-.1.4 1.3 1.6 2.3 3.1 2.3-1.1.9-2.5 1.4-4.1 1.4H0c1.5.9 3.2 1.5 5 1.5 6 0 9.3-5 9.3-9.3v-.4C15 4.3 15.6 3.7 16 3z"
                                ></path>
                            </svg>
                        </a>
                        
                        <a 
                            href={siteContent.footer.links.find(link => link.label === 'GitHub')?.href || '#'} 
                            title="View on GitHub" 
                            aria-label="View on GitHub"
                            class="group relative p-3 rounded-xl bg-muted/30 border border-border/30 hover:border-foreground/50 hover:bg-foreground/5 transition-all duration-200 hover:scale-105"
                            target="_blank" 
                            rel="noopener noreferrer"
                        >
                            <div class="absolute inset-0 rounded-xl bg-gradient-to-br from-foreground/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
                            <svg
                                class="relative fill-current text-muted-foreground group-hover:text-foreground transition-colors duration-200"
                                width="16"
                                height="16"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 16 16"
                            >
                                <path
                                    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
                                ></path>
                            </svg>
                        </a>
                        
                        <a 
                            href={siteContent.footer.links.find(link => link.label === 'LinkedIn')?.href || '#'} 
                            title="Connect on LinkedIn" 
                            aria-label="Connect on LinkedIn"
                            class="group relative p-3 rounded-xl bg-muted/30 border border-border/30 hover:border-blue-600/50 hover:bg-blue-600/5 transition-all duration-200 hover:scale-105"
                            target="_blank" 
                            rel="noopener noreferrer"
                        >
                            <div class="absolute inset-0 rounded-xl bg-gradient-to-br from-blue-600/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
                            <svg
                                class="relative fill-current text-muted-foreground group-hover:text-blue-600 transition-colors duration-200"
                                width="16"
                                height="16"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 16 16"
                            >
                                <path
                                    d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"
                                ></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
            
            <!-- Bottom border with subtle gradient -->
            <div class="mt-8 h-px bg-gradient-to-r from-transparent via-border/50 to-transparent"></div>
        </div>
    </Container>
</footer>
