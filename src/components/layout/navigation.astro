---
import { Logo } from "@/components";
import ThemeToggle from "@/components/ui/ThemeToggle.astro";
import { siteContent } from "@/utils/siteContent";
---

<section 
  x-data="{ showMenu: false }" 
  x-effect="document.body.classList.toggle('overflow-hidden', showMenu)" 
  class="fixed top-0 left-0 right-0 z-50 px-6 glass-nav"
>
    <div class="mx-auto max-w-7xl">
        <nav class="relative z-50 h-20 select-none" role="navigation" aria-label="Main navigation">
            <div class="flex overflow-hidden relative flex-wrap justify-between items-center mx-auto h-20 font-medium sm:px-4 md:overflow-visible md:px-2">
                <!-- Logo -->
                <div class="flex justify-start items-center pr-4 h-full">
                    <a 
                      href="/" 
                      title="Lila Fuches - Home" 
                      aria-label="Lila Fuches home page"
                      class="flex items-center focus-ring rounded-lg p-1 -m-1"
                    >
                        <Logo class="h-10 w-auto" />
                    </a>
                </div>

                <!-- Desktop Navigation -->
                <div class="hidden md:flex flex-1 justify-center items-center space-x-8">
                    {siteContent.navigation.menuItems.map(item => (
                        <a 
                          href={item.href} 
                          class="text-foreground hover:text-primary transition-colors duration-200 font-medium focus-ring rounded-lg px-3 py-2"
                        >
                            {item.label}
                        </a>
                    ))}
                </div>

                <!-- Theme Toggle & Mobile Menu Button -->
                <div class="flex items-center space-x-2">
                    <ThemeToggle />
                    
                    <!-- Mobile Menu Button -->
                    <button
                      @click="showMenu = !showMenu"
                      type="button"
                      aria-label="Toggle navigation menu"
                      aria-expanded="false"
                      x-bind:aria-expanded="showMenu"
                      class="md:hidden inline-flex items-center justify-center w-10 h-10 p-2 rounded-lg transition-colors duration-200 bg-muted hover:bg-border focus-ring"
                    >
                        <svg 
                          x-show="!showMenu" 
                          class="w-5 h-5" 
                          fill="none" 
                          stroke="currentColor" 
                          stroke-width="2" 
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                        <svg 
                          x-show="showMenu" 
                          class="w-5 h-5" 
                          fill="none" 
                          stroke="currentColor" 
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>
        </nav>

        <!-- Mobile Menu Overlay -->
        <div 
          x-show="showMenu"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 scale-95"
          x-transition:enter-end="opacity-1 scale-100"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-1 scale-100"
          x-transition:leave-end="opacity-0 scale-95"
          class="md:hidden absolute top-full left-0 right-0 bg-background border border-border rounded-b-xl shadow-strong mx-6 p-4"
          @click.outside="showMenu = false"
        >
            <div class="flex flex-col space-y-2">
                {siteContent.navigation.menuItems.map(item => (
                    <a 
                      href={item.href} 
                      @click="showMenu = false"
                      class="text-foreground hover:text-primary hover:bg-muted transition-colors duration-200 font-medium rounded-lg px-3 py-3 text-left focus-ring"
                    >
                        {item.label}
                    </a>
                ))}
            </div>
        </div>

        <!-- Navigation border -->
        <div class="w-full h-px bg-gradient-to-r from-transparent via-border to-transparent"></div>
    </div>
</section>
